NEON_STAGE_URL=postgresql://...
NEON_PROD_URL=postgresql://...
AUTH_SECRET=<same value as the FE>
INTERNAL_API_SECRET=<shared with the FE; gates /auth/upsert>
FE_ORIGINS=https://your-fe.vercel.app

# Resume import. Use a separate Gemini project + Groq key per env (stage vs prod): budgets
# are counted per database, so a shared key gets double the budget.
GEMINI_API_KEY=
GROQ_API_KEY=
AI_PRIMARY_MODEL=gemini-3.5-flash-lite
AI_FALLBACK_GROQ_MODEL=openai/gpt-oss-120b
AI_MAX_CONCURRENT=3
AI_USER_DAILY_CALLS=10
GEMINI_DAILY_BUDGET=400
GROQ_DAILY_TOKEN_BUDGET=180000
# Local dev / tests only: 1 = fixture provider, no network. Ignored on production deploys.
AI_FAKE_PROVIDER=
# With AI_FAKE_PROVIDER=1: per-provider outcome, e.g. gemini:ai_unavailable,groq:ok
AI_FAKE_RESULT=

# Sentry error tracking. With no DSN the SDK is disabled (fine for local dev).
SENTRY_DSN=
